{
  "name": "broxer",
  "version": "0.1.1",
  "description": "Broxer Web Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "EminGeze",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.eming.broxer",
    "productName": "Broxer",
    "publish": {
      "provider": "generic",
      "url": "https://emin-g.web.app/download/"
    },
    "win": {
      "target": [
        "nsis-web"
      ],
      "icon": "icon.ico"
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Broxer",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "uninstallDisplayName": "Broxer Kaldır"
    }
  }
}
